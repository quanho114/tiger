# Tiger — Supabase Edge Functions local env TEMPLATE.
# Copy to supabase/functions/.env for local `supabase functions serve`.
# NEVER commit real secrets. This file contains placeholders only.
# Production secrets live in the hosting provider / Vault, never in git.

CONCIERGE_V2_ENABLED=true
CONCIERGE_SESSION_STORE=postgres
ENVIRONMENT=local

# Upstash Redis (optional session backend) — placeholder only.
CONCIERGE_REDIS_REST_URL=https://example.upstash.io
CONCIERGE_REDIS_REST_TOKEN=replace-me-local-only
CONCIERGE_REDIS_KEY_PREFIX=tiger:concierge:

# Local LLM dev shim (never production).
CONCIERGE_LLM_DEV_BASE_URL=http://host.docker.internal:20128/v1

# Production signing / provider secrets (SET IN HOST ENV, never here):
# QUOTE_SECRET=
# CAPABILITY_SECRET=
# HASH_SALT=
# OPENAI_API_KEY= / ANTHROPIC_API_KEY= / GEMINI_API_KEY=
# (or rows in concierge_llm_config with secret_reference to Vault)
