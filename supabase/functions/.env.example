# Local Edge Functions configuration; no secrets.
# Use directly with --env-file supabase/functions/.env.example.
# Supabase CLI supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY locally.
# ENVIRONMENT=local permits development defaults; never deploy this file.
ENVIRONMENT=local

# Inside the Edge Functions container, reach PostgreSQL by Docker service name.
DATABASE_URL=postgresql://postgres:postgres@supabase_db_tiger:5432/postgres

# Additional public HTTPS provider hostnames, comma-separated; no URLs or keys.
# api.openai.com is already allowed by runtime code.
CONCIERGE_LLM_ALLOWED_HOSTS=

# Concierge sessions use PostgreSQL. No Redis or local AI shim is required.
# Configure real providers through the admin Chatbot settings; never save keys here.
# Deployment secrets (database, service-role, signing, cron) belong in the
# hosting secret manager, not this template or frontend VITE_* variables.
