# ==============================================================================
# Tiger 345 - Environment Variables Template
# Copy to .env.local for Vite. Public frontend configuration only.
# Never put provider keys or service-role keys here.
# ==============================================================================

# Frontend Public Variables (Vite)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-your-local-public-anon-key
VITE_SITE_URL=http://localhost:5173

# Database test tools do not automatically load this file. They default to
# localhost:54322; use process environment for an isolated test target.

# ==============================================================================
# Local Supabase Service Ports Reference:
# - API Gateway (Kong): 54321
# - PostgreSQL Database: 54322
# - Supabase Studio: 54323
# - Inbucket / Mailpit Web UI: 54324
# - Shadow DB (db diff): 54320
# ==============================================================================
