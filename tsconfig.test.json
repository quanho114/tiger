{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@contracts/*": ["./supabase/functions/_shared/contracts/*"],
      "@contracts": ["./supabase/functions/_shared/contracts/index.ts"]
    }
  },
  "include": ["tests", "src", "supabase/functions/_shared", "supabase/functions/deno.d.ts"]
}
